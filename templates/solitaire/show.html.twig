{% extends 'layout.html.twig' %}

{% block body %}
    {{ parent() }}
    <h1>Jeux de société</h1>

    <h2>Solitaire</h2>

    <h3>{{ game.name }}</h3>

    {% if game.state.isFinished %}
        <p>Partie terminée</p>
    {% endif %}

    <div style="display: inline-block;">
        <div id="root"></div>
    </div>


{% endblock %}

{% block javascripts %}
    {% block importmap %}{{ importmap('solitaire') }}{% endblock %}
    <script type="module">
        import React from 'react';
        import {createRoot} from 'react-dom/client';
        import {Solitaire} from 'solitaire';
        const actionsString = '{{ game.state.actions }}';
        function postAction(actionString){
            return fetch('/solitaire/{{ game.id }}/action', {
                method: 'POST',
                body: JSON.stringify({action: actionString})
            }).then(res => res.ok ? res.json() : null);
        }
        function onGameFinished(){
            window.location.reload();
        }
        createRoot(document.getElementById('root')).render(React.createElement(Solitaire, {actionsString, postAction, onGameFinished}));
    </script>
{% endblock %}